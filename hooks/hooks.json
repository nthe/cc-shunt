{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-large-read.sh\" claude",
            "timeout": 10,
            "statusMessage": "Shunt: route broad reads to Scout"
          }
        ]
      }
    ]
  }
}
